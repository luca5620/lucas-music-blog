# =============================================================================
# Environment variables — copy to .env.local and fill in.
# .env.local is gitignored; NEVER commit real values.
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---
# These two are safe to expose to the browser: the anon key only works
# through Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Spotify (developer.spotify.com → Dashboard → your app) ---
# Server-only: used for the now-playing widget and admin release imports.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
# Obtained once via /api/auth/login → /api/auth/callback (local dev only).
SPOTIFY_REFRESH_TOKEN=your-refresh-token
