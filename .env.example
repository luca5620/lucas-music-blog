# =============================================================================
# Environment variables — copy to .env.local and fill in.
# .env.local is gitignored; NEVER commit real values.
# Set the same values in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---
# These two are safe to expose to the browser: the anon key only works
# through Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Spotify (developer.spotify.com → Dashboard → your app) ---
# Server-only: powers catalog search + on-demand release imports.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

# --- Genius (https://genius.com/api-clients → New API Client) ---
# Server-only: deep-catalog search — unreleased tracks, leaks, loosies.
# Use the "Client Access Token" shown after creating the API client.
# The site works without it; Genius results just won't appear.
GENIUS_ACCESS_TOKEN=your-client-access-token

## Upstash Redis (rate limiting)
## Without these the limiter falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

## Social sign-in (Google / Apple) — which buttons the login and
## signup pages show. Comma list: "google", "apple", or both.
## Unset = neither, so the buttons stay hidden until the provider is
## actually configured in Supabase → Authentication → Providers
## (an enabled button with no provider behind it just errors).
NEXT_PUBLIC_SOCIAL_LOGIN=google,apple

# --- AI search / Bing (docs/AI-SEARCH.md, 2026-09-03) — all optional ---
# IndexNow key from Bing Webmaster Tools → Settings → IndexNow. With it
# set, new review + release pages are pinged to Bing the moment they
# exist and /<key>.txt is served as the ownership proof. Needs a redeploy.
INDEXNOW_KEY=
# Bing Webmaster Tools "meta tag" verification code (msvalidate.01).
# Not needed if you verify via "Import from Google Search Console".
NEXT_PUBLIC_BING_VERIFICATION=
# Google Search Console meta-tag code, if verifying that way.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Tolgee CLI only (npm run i18n:push / i18n:pull) - a PROJECT-scoped API key from
# app.tolgee.io. Local .env.local only; the site never reads it, so not on Vercel.
TOLGEE_API_KEY=
